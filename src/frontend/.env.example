# SkillBoost LMS Frontend Environment Configuration

# Backend API Gateway for Authentication & Microservices
VITE_AUTH_API_URL=http://localhost:4040/auth-provider/auth

# Google OAuth 2.0 Web Client ID (from Google Cloud Console: https://console.cloud.google.com)
# Example: 1234567890-abcdefg.apps.googleusercontent.com
# If left empty, the application runs in Demo OAuth Mode with simulated student sign-in.
VITE_GOOGLE_CLIENT_ID=

# Facebook Login App ID (from Meta for Developers: https://developers.facebook.com)
# Example: 123456789012345
# If left empty, the application runs in Demo OAuth Mode with simulated student sign-in.
VITE_FACEBOOK_APP_ID=

# OAuth Redirect URI (must match the authorized redirect URI in Google & Facebook consoles)
VITE_OAUTH_REDIRECT_URI=http://localhost:5173/login