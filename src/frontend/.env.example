# SkillBoost LMS Frontend Environment Variables

# Google OAuth Client ID (Get from Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Facebook OAuth App ID (Get from Meta for Developers)
VITE_FACEBOOK_APP_ID=your_facebook_app_id_here

# OAuth Redirect URL
VITE_OAUTH_REDIRECT_URI=http://localhost:5173/login

# API Gateway Auth Provider URL (Gateway at :4040 routes to auth-provider at :4001)
VITE_AUTH_API_URL=http://localhost:4040/auth-provider/auth
